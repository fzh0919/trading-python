# ============================================================
# Trading 212 x Gemini AI Advisor (Python v5.0) Environment
# Copy to .env and fill in your real keys. NEVER commit .env!
# ============================================================

# --- Trading 212 API (Read-only permissions recommended) ---
T212_ISA_KEY=
T212_ISA_SECRET=
T212_INVEST_KEY=
T212_INVEST_SECRET=

# --- Google Gemini API ---
GEMINI_API_KEY=

# --- DeepSeek Official API (Hybrid routing & cross-vendor failover) ---
DEEPSEEK_API_KEY=
# Official endpoint only by default (must be https; http:// is rejected at startup).
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Outbound egress allowlist (defence in depth) ---
# Third-party model relays are REJECTED unless their hostname is opted in here.
# Official hosts already allowed: api.deepseek.com / generativelanguage.googleapis.com /
# api.anthropic.com (LLM) and live.trading212.com / demo.trading212.com (broker).
# LLM_EGRESS_ALLOWED_HOSTS=relay.example.com
# T212_EGRESS_ALLOWED_HOSTS=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Free Market & Macro APIs (Highly Recommended) ---
# Finnhub (free tier: 60 calls/min - US quotes, earnings calendar, news): https://finnhub.io/
FINNHUB_API_KEY=
# FRED (free: 120 calls/min - US 10Y yield, Fed rate, CPI, VIX): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Homelab Ops-Notify Gateway (N95 homelab-net) ---
# N95 internal endpoint example: http://ops-notify:8000/alert
# Leave empty during local unit tests or direct Telegram ops fallback.
OPS_NOTIFY_URL=
# Optional Bearer token if ops-notify requires authentication
OPS_NOTIFY_TOKEN=
